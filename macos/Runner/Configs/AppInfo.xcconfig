// Application-level settings for the Runner target.
//
// This may be replaced with something auto-generated from metadata (e.g., pubspec.yaml) in the
// future. If not, the values below would default to using the project name when this becomes a
// 'flutter create' template.

// The application's name. By default this is also the title of the Flutter window.
PRODUCT_NAME = Tangerine

// The application's bundle identifier
PRODUCT_BUNDLE_IDENTIFIER = com.example.studyStream

// The copyright displayed in application information
PRODUCT_COPYRIGHT = Copyright © 2026 com.example. All rights reserved.

// Tangerine's native engine. Development runtime matches the original application.
VLC_APP_PATH = /Applications/VLC.app
HEADER_SEARCH_PATHS = $(inherited) "$(VLC_APP_PATH)/Contents/MacOS/include"
SWIFT_INCLUDE_PATHS = $(inherited) "$(PROJECT_DIR)/Runner/CLibVLC"
LIBRARY_SEARCH_PATHS = $(inherited) "$(VLC_APP_PATH)/Contents/MacOS/lib"
OTHER_LDFLAGS = $(inherited) -lvlc
LD_RUNPATH_SEARCH_PATHS = $(inherited) @executable_path/../Frameworks/VLC/lib
ENABLE_USER_SCRIPT_SANDBOXING = NO
